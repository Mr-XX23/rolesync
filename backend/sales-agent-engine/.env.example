# Sales Agent Engine settings. Shared platform values (DATABASE_PROVIDER_USERNAME,
# DATABASE_PASSWORD, JWT_ISSUER, EUREKA_SERVER, GEMINI_API_KEY, OPEN_ROUTER_API,
# COMPOSIO_API_KEY, LANGSMITH_*) come from backend/.env; this file lists engine-specific
# overrides. Copy to .env (gitignored) for local runs.

# --- service ---
SALES_AGENT_PORT=8084
SALES_AGENT_HOSTNAME=sales-agent-engine
SALES_AGENT_LOG_LEVEL=INFO

# --- database (either a full URL, or the parts; user/password default to DATABASE_*) ---
# SALES_AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/rolesync-micro-sales-agent
SALES_AGENT_DB_HOST=localhost
SALES_AGENT_DB_PORT=5432
SALES_AGENT_DB_NAME=rolesync-micro-sales-agent

# --- redis (event streams, run leases, membership cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
SALES_AGENT_REDIS_DB=0

# --- identity ---
# auth-service signing keys; the PEM (default ../auth-service/src/main/resources/keys/public_key.pem) is the fallback
# SALES_AGENT_JWT_JWKS_URL=http://auth-service:8082/api/v1/auth/oauth2/jwks
# SALES_AGENT_JWT_PUBLIC_KEY_PATH=
SALES_AGENT_WORKSPACE_SERVICE_URL=http://localhost:8083
SALES_AGENT_MEMBERSHIP_CACHE_SECONDS=60
# knowledge vault + catalog (not published on the host; in docker use http://data-pipeline:8000)
SALES_AGENT_DATA_PIPELINE_URL=http://localhost:8000

# --- model routing (complex → Gemini; simple + failover → OpenRouter, tried in order) ---
SALES_AGENT_MODEL_COMPLEX=gemini-3.5-flash
SALES_AGENT_MODELS_SIMPLE=nvidia/nemotron-3.5-lightning:free
SALES_AGENT_MODELS_FAILOVER=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free
SALES_AGENT_LLM_TIMEOUT_SECONDS=120
# Google Search grounding for web answers (free tier: only 2.5 Flash serves grounded requests)
SALES_AGENT_MODEL_WEB_GROUNDING=gemini-2.5-flash

# --- guardrails: per-turn limits (a breach ends the turn HALTED) ---
# model steps per turn; a sub-agent's steps count here too, so delegating turns need headroom
SALES_AGENT_MAX_STEPS_PER_TURN=18
SALES_AGENT_MAX_TOOL_CALLS_PER_TURN=40
SALES_AGENT_MAX_TOKENS_PER_TURN=1000000
# the same tool with the same arguments more often than this in one turn is treated as a loop
SALES_AGENT_MAX_IDENTICAL_TOOL_CALLS=2

# --- per-workspace budgets (checked before a turn starts; 0 disables rate / token budgets) ---
SALES_AGENT_MAX_CONCURRENT_RUNS_PER_TENANT=5
SALES_AGENT_TURNS_PER_MINUTE_PER_USER=10
SALES_AGENT_TOKENS_PER_DAY_PER_TENANT=5000000
SALES_AGENT_RUN_LEASE_SECONDS=60

# --- connectors (pin Composio toolkit versions: toolkit=version,...) ---
SALES_AGENT_COMPOSIO_TOOLKIT_VERSIONS=gmail=20260911_00,googlecalendar=20260902_00,slack=20260911_00,notion=20260911_00,googledrive=20260902_00

# --- web search: Tavily pages (key goes in backend/.env); Google grounding uses GEMINI_API_KEY ---
# TAVILY_API_KEY=tvly-...
# SALES_AGENT_TAVILY_URL=https://api.tavily.com

# --- workspace records (goals, tasks, notes in workspace-service) ---
SALES_AGENT_WORKSPACE_SYNC_ENABLED=true
SALES_AGENT_WORKSPACE_SYNC_INTERVAL_SECONDS=2

# --- discovery ---
SALES_AGENT_EUREKA_ENABLED=false

# --- approvals / tools / streaming ---
# an approval nobody decides in time expires; the run then offers to undo what its request already did
SALES_AGENT_APPROVAL_TTL_SECONDS=86400
SALES_AGENT_TOOL_TIMEOUT_SECONDS=30
# retries for transient failures of reads and undo steps (writes are never retried)
SALES_AGENT_TOOL_READ_ATTEMPTS=3
SALES_AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.5
# a tool that keeps failing transiently fails fast for a cool-down
SALES_AGENT_CIRCUIT_BREAKER_FAILURES=5
SALES_AGENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# --- generated documents and quotes (Google Drive, else the workspace knowledge base) ---
SALES_AGENT_DOCUMENT_MAX_BYTES=5242880
# a Unicode TTF for PDFs; the Docker image uses DejaVu Sans, local runs fall back to Arial
# SALES_AGENT_PDF_FONT_PATH=
# the frontend route the chat links knowledge-base documents to
SALES_AGENT_KNOWLEDGE_VAULT_LINK=/salesman/knowledge-vault
SALES_AGENT_SSE_PING_SECONDS=15

# --- context and memory ---
# the prompt budget for one model step; earlier turns are summarized to fit
SALES_AGENT_CONTEXT_BUDGET_TOKENS=48000
# how many recent requests stay in the prompt word for word
SALES_AGENT_CONTEXT_KEEP_RECENT_TURNS=2
# a longer tool result is stored whole and referenced instead (read_offloaded_result reads it back)
SALES_AGENT_TOOL_RESULT_MAX_CHARS=24000
# facts kept per memory (the rep, a customer, a deal); the oldest give way
SALES_AGENT_MEMORY_FACTS_PER_KEY=100
# versions kept per memory row
SALES_AGENT_MEMORY_VERSIONS_KEPT=20
# how long the rep's workspace profile (persona, communication style) is cached
SALES_AGENT_PROFILE_CACHE_SECONDS=300
